# Example environment for agents sharing one ledger (source it from your agent's shell profile).
export AGENT_USAGE_DIR="$HOME/.local/share/agent-usage"    # logs/YYYY-MM-DD.jsonl live here
export AGENT_USAGE_STATE="$HOME/.local/state/agent-usage"  # dedupe / import state
export AGENT_NAME="research-bot"                           # who is making the calls
# Extra secret sources to scrub from error text (colon-separated files; comma-separated env var names):
# export AGENT_USAGE_KEY_FILES="$HOME/.config/myapi/key:$HOME/.config/other/key"
# export AGENT_USAGE_SECRET_ENV="OPENAI_API_KEY,MY_GATEWAY_KEY"
